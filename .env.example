# A reference for the variables, not a file anything loads. The CLI reads
# process.env and the pipeline has no dotenv dependency, so a key written into
# .env and left there reads as unset: `refrain bakeoff --dry-run` answers
# `Missing keys:` while the key sits in the file looking correct.
#
# Export them, or load the file yourself before the run:
#   set -a; . ./.env; set +a
#   node --env-file=.env packages/pipeline/dist/cli.js bakeoff --dry-run
#
# .env and .env.local are gitignored. Nothing here is needed to run the app,
# the tests or the pilot render — only `refrain bakeoff` against a real
# provider uses these.

# --- the renders ------------------------------------------------------------
# The variable a provider config names in content/providers/*.json. Put the key
# in the environment, never in the config: the loader refuses a config with a
# key pasted where the variable name goes.
ELEVENLABS_API_KEY=

# --- the scoring ------------------------------------------------------------
# Word accuracy is what a bake-off exists to measure, so one of these must work
# or `refrain bakeoff` refuses to spend anything.
#
# Cheapest option is neither: install whisper locally and set nothing. Any
# binary named `whisper-cli` or `whisper` on PATH is picked up automatically.
#
# Otherwise, any OpenAI-compatible speech-to-text endpoint:
#   OpenAI  https://api.openai.com/v1/audio/transcriptions        (whisper-1)
#   Groq    https://api.groq.com/openai/v1/audio/transcriptions   (whisper-large-v3)
REFRAIN_ASR_URL=
REFRAIN_ASR_KEY=
# Defaults to whisper-1, which is wrong for Groq — set it there.
REFRAIN_ASR_MODEL=
