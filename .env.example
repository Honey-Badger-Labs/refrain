# Copy to .env and fill in. .env and .env.local are gitignored.
# Nothing here is needed to run the app, the tests or the pilot render —
# only `refrain bakeoff` against a real provider uses these.

# --- the renders ------------------------------------------------------------
# The variable a provider config names in content/providers/*.json. Put the key
# in the environment, never in the config: the loader refuses a config with a
# key pasted where the variable name goes.
ELEVENLABS_API_KEY=

# --- the scoring ------------------------------------------------------------
# Word accuracy is what a bake-off exists to measure, so one of these must work
# or `refrain bakeoff` refuses to spend anything.
#
# Cheapest option is neither: install whisper locally and set nothing. Two
# different programs answer to this name and they take different flags, so
# both are driven, and each is checked by running it rather than by finding it:
#
#   pip install openai-whisper    -> `whisper`, fetches its own weights. Done.
#   brew install whisper-cpp      -> `whisper-cli`, ships NO weights. Download a
#                                    ggml model and point WHISPER_MODEL at it,
#                                    or drop it in ~/.cache/whisper/.
#
# Use medium or better. `base.en` is small enough to be wrong about the words
# it is meant to be checking: on the first bake-off it scored three renders at
# 85.4% that `medium.en` scored at 94.0%, and the difference was entirely the
# transcriber. A weak one does not report a weak model — it reports a weak
# model that is not there.
#
# Without weights, whisper.cpp is on the PATH and cannot transcribe a thing.
# `refrain bakeoff` will say so and refuse rather than bill you for renders
# nobody can score.
WHISPER_MODEL=
#
# Otherwise, a hosted speech-to-text endpoint. OpenAI-compatible hosts and
# xAI Grok STT are both supported:
#   OpenAI  https://api.openai.com/v1/audio/transcriptions        (whisper-1)
#   Groq    https://api.groq.com/openai/v1/audio/transcriptions   (whisper-large-v3)
#   xAI     https://api.x.ai/v1/stt                               (grok-voice-transcribe-2.0)
REFRAIN_ASR_URL=
REFRAIN_ASR_KEY=
# Defaults to whisper-1, which is wrong for Groq — set it there. For xAI
# (URL host api.x.ai, or REFRAIN_ASR_PROVIDER=xai) the default is
# grok-voice-transcribe-2.0.
REFRAIN_ASR_MODEL=
# Optional. openai or xai. If unset, inferred from REFRAIN_ASR_URL
# (api.x.ai → xai, everything else → openai).
REFRAIN_ASR_PROVIDER=
